@Projeto.Api_HostAddress = http://localhost:5229

# TipoPerfil: 0 = TUTOR, 1 = PASSEADOR, 2 = AMBOS
POST {{Projeto.Api_HostAddress}}/cadastro
Content-Type: application/json

{
  "nome": "Maria",
  "email": "maria@petwalk.com",
  "telefone": "11999999999",
  "endereco": "Rua das Flores, 10",
  "tipoPerfil": 0,
  "senha": "123456"
}

###

# Passeador com cobrança configurada: TipoCobranca 0 = POR_HORA, 1 = POR_HORA_COM_ADICIONAL_DE_PORTE
POST {{Projeto.Api_HostAddress}}/cadastro
Content-Type: application/json

{
  "nome": "Bia",
  "email": "bia@petwalk.com",
  "telefone": "11888888888",
  "endereco": "Rua B, 20",
  "tipoPerfil": 1,
  "senha": "123456",
  "valorHora": 30,
  "tipoCobranca": 1
}

###

# Esperado: 409 Conflict — {"erro":"Usuário não possui perfil de passeador"}
# TUTOR com valorHora: DefinirCobranca recusa porque o perfil não é de passeador.
POST {{Projeto.Api_HostAddress}}/cadastro
Content-Type: application/json

{
  "nome": "Tutor com cobrança",
  "email": "tutor-cobranca@petwalk.com",
  "telefone": "11777777777",
  "endereco": "Rua C, 30",
  "tipoPerfil": 0,
  "senha": "123456",
  "valorHora": 30
}

###

POST {{Projeto.Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "maria@petwalk.com",
  "senha": "123456"
}

###

# Esperado: 409 Conflict — {"erro":"E-mail já cadastrado"} (REG-010)
POST {{Projeto.Api_HostAddress}}/cadastro
Content-Type: application/json

{
  "nome": "Maria",
  "email": "maria@petwalk.com",
  "telefone": "11999999999",
  "endereco": "Rua das Flores, 10",
  "tipoPerfil": 0,
  "senha": "123456"
}

###

# Esperado: 401 Unauthorized — {"erro":"E-mail ou senha inválidos"}
POST {{Projeto.Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "maria@petwalk.com",
  "senha": "senha-errada"
}

###

# REG-011 (usuário bloqueado → 403 {"erro":"Usuário está bloqueado"}) não aparece aqui:
# não existe endpoint para bloquear usuário. A regra fica coberta por teste unitário (Prompt 7).

###

# ---------- Pets do tutor (FLX-007) ----------
# Os exemplos usam o usuário 1 (Maria, TUTOR) criado no primeiro POST /cadastro acima.

# Esperado: 200 — lista com os pets do usuário ([] quando ele ainda não tem nenhum)
GET {{Projeto.Api_HostAddress}}/usuarios/1/pets

###

# Esperado: 201 Created — PetResponse com id, vacinas: [] e tutorId: 1
# Porte: 0 = PEQUENO, 1 = MEDIO, 2 = GRANDE
# Usuário sem perfil de tutor: 422 {"erro":"Usuário não possui perfil de tutor"} (REG-002)
POST {{Projeto.Api_HostAddress}}/usuarios/1/pets
Content-Type: application/json

{
  "nome": "Rex",
  "especie": "Cachorro",
  "raca": "Vira-lata",
  "porte": 1,
  "idade": 3,
  "observacoes": "Muito dócil"
}

###

# Esperado: 200 com o pet; 404 {"erro":"Pet não encontrado"} para pet inexistente ou de outro tutor (REG-005)
GET {{Projeto.Api_HostAddress}}/usuarios/1/pets/1

###

# Esperado: 200 com os dados atualizados; 400 {"erro":"Idade inválida."} se a idade sair de 0..30
PUT {{Projeto.Api_HostAddress}}/usuarios/1/pets/1
Content-Type: application/json

{
  "nome": "Rex",
  "especie": "Cachorro",
  "raca": "Vira-lata",
  "porte": 2,
  "idade": 4,
  "observacoes": "Agora adulto"
}

###

# Esperado: 204 No Content; repetir a chamada devolve 404 {"erro":"Pet não encontrado"}
DELETE {{Projeto.Api_HostAddress}}/usuarios/1/pets/1

###

# Esperado: 404 {"erro":"Usuário não encontrado"}
GET {{Projeto.Api_HostAddress}}/usuarios/999/pets

###

# ---------- Passeadores (FLX-001) ----------

# Esperado: 200 — só usuários PASSEADOR/AMBOS com status ATIVO (o tutor Maria fica de fora)
# Cada item traz apenas id, nome, mediaAvaliacao, valorHora e tipoCobranca (REG-007).
GET {{Projeto.Api_HostAddress}}/passeadores

###

# ---------- Solicitação de passeio (FLX-002) ----------
# Ordem para reproduzir: POST /cadastro (Maria, TUTOR = id 1), POST /cadastro (Bia, PASSEADOR = id 2),
# POST /usuarios/1/pets (pet = id 1) e então a solicitação abaixo.

# Esperado: 201 Created — PasseioResponse com status SOLICITADO, valor calculado na solicitação
# e local igual ao informado (REG-007: nunca o endereço do perfil).
# Também grava uma notificação PASSEIO_SOLICITADO para o passeador (id 2).
POST {{Projeto.Api_HostAddress}}/passeios
Content-Type: application/json

{
  "usuarioId": 1,
  "petId": 1,
  "passeadorId": 2,
  "dataHora": "2027-01-01T10:00:00Z",
  "duracaoMinutos": 60,
  "local": "Rua das Flores, 10"
}

###

# Esperado: 404 {"erro":"Usuário não encontrado"}
POST {{Projeto.Api_HostAddress}}/passeios
Content-Type: application/json

{
  "usuarioId": 999,
  "petId": 1,
  "passeadorId": 2,
  "dataHora": "2027-01-01T10:00:00Z",
  "duracaoMinutos": 60,
  "local": "Rua das Flores, 10"
}

###

# Esperado: 404 {"erro":"Passeador não encontrado"}
POST {{Projeto.Api_HostAddress}}/passeios
Content-Type: application/json

{
  "usuarioId": 1,
  "petId": 1,
  "passeadorId": 999,
  "dataHora": "2027-01-01T10:00:00Z",
  "duracaoMinutos": 60,
  "local": "Rua das Flores, 10"
}

###

# Esperado: 422 {"erro":"O pet informado não pertence ao tutor solicitante"} (REG-005)
# Vale para petId inexistente ou de outro tutor.
POST {{Projeto.Api_HostAddress}}/passeios
Content-Type: application/json

{
  "usuarioId": 1,
  "petId": 999,
  "passeadorId": 2,
  "dataHora": "2027-01-01T10:00:00Z",
  "duracaoMinutos": 60,
  "local": "Rua das Flores, 10"
}

###

# Esperado: 422 {"erro":"A data e hora do passeio devem ser futuras"} (REG-008)
POST {{Projeto.Api_HostAddress}}/passeios
Content-Type: application/json

{
  "usuarioId": 1,
  "petId": 1,
  "passeadorId": 2,
  "dataHora": "2020-01-01T10:00:00Z",
  "duracaoMinutos": 60,
  "local": "Rua das Flores, 10"
}

###

# ---------- Histórico do usuário ----------
# Depois de criar o passeio acima, o mesmo passeio aparece para as duas partes,
# cada uma com o seu papel (comparação de referência com o participante).

# Esperado: 200 — lista com papel "TUTOR" e sem endereço/e-mail/telefone/senha (REG-007)
GET {{Projeto.Api_HostAddress}}/usuarios/1/passeios

###

# Esperado: 200 — o mesmo passeio, agora com papel "PASSEADOR"
GET {{Projeto.Api_HostAddress}}/usuarios/2/passeios

###

# Esperado: 404 {"erro":"Usuário não encontrado"}
GET {{Projeto.Api_HostAddress}}/usuarios/999/passeios

###

# ---------- Aceite e recusa do passeio (FLX-003 / FLX-009) ----------
# O passeio 1 foi criado pelo POST /passeios acima (tutor 1, passeador 2).

# Esperado: 200 — status 1 (ACEITO), papel "PASSEADOR" e a notificação PASSEIO_ACEITO criada para o tutor (1)
POST {{Projeto.Api_HostAddress}}/passeios/1/aceitar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# Esperado: 422 {"erro":"Passeio não pertence a este passeador"} (REG-003)
# O tutor (1) não é o passeador escolhido. Vale também para passeador bloqueado ou sem perfil.
POST {{Projeto.Api_HostAddress}}/passeios/1/aceitar
Content-Type: application/json

{
  "usuarioId": 1
}

###

# Esperado: 200 — status 4 (RECUSADO) e notificação PASSEIO_RECUSADO para o tutor.
# A recusa só vale a partir de SOLICITADO: crie outro passeio com POST /passeios antes de testar.
POST {{Projeto.Api_HostAddress}}/passeios/2/recusar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# Esperado: 404 {"erro":"Passeio não encontrado"}
POST {{Projeto.Api_HostAddress}}/passeios/999/aceitar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# ---------- Ciclo de vida: iniciar e finalizar (FLX-008 / FLX-004) ----------
# Continuando do passeio 1, que ficou ACEITO no exemplo de aceite acima.

# Esperado: 200 — status 2 (EM_ANDAMENTO) e notificação PASSEIO_INICIADO para o tutor (1)
POST {{Projeto.Api_HostAddress}}/passeios/1/iniciar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# Esperado: 200 — status 3 (FINALIZADO) e notificação PASSEIO_FINALIZADO para o tutor (1)
POST {{Projeto.Api_HostAddress}}/passeios/1/finalizar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# Esperado: 422 {"erro":"Transição não permitida a partir do estado atual"}
POST {{Projeto.Api_HostAddress}}/passeios/1/iniciar
Content-Type: application/json

{
  "usuarioId": 2
}

###

# ---------- Cancelamento (FLX-009, REG-004) ----------

# Caminho feliz: crie um passeio novo (3), aceite-o e cancele pelo tutor.
# Esperado: 200 — status 5 (CANCELADO) e notificação PASSEIO_CANCELADO para o passeador (2)
POST {{Projeto.Api_HostAddress}}/passeios/3/cancelar
Content-Type: application/json

{
  "usuarioId": 1
}

###

# Cancelar depois de iniciado não é permitido (REG-004): use um passeio aceito e iniciado (ex.: 4).
# Esperado: 422 {"erro":"Passeio não pode ser cancelado no estado atual."}
POST {{Projeto.Api_HostAddress}}/passeios/4/cancelar
Content-Type: application/json

{
  "usuarioId": 1
}
